# ========================================================
# پیکربندی محیط سامانه مدیریت باغات (دامنه avinia.ir)
# ========================================================

# پورت سرور (به صورت خودکار توسط Phusion Passenger در cPanel یا پیش‌فرض 3000 تنظیم می‌شود)
PORT=3000
NODE_ENV=production

# آدرس دامنه وب‌سایت
APP_URL=https://avinia.ir
VITE_API_BASE_URL=https://avinia.ir/api

# مسیرهای cPanel (مخصوص هاست چند دامنه‌ای - کاملاً مستقل از سایر سایت‌ها):
# مسیر مخزن و بک‌اند در cPanel:
CPANEL_REPO_PATH=/home/YOUR_CPANEL_USER/repositories/agrimanage
# مسیر داکیومنت روت دامنه اختصاصی avinia.ir (نه public_html اصلی):
DOMAIN_DOC_ROOT=/home/YOUR_CPANEL_USER/public_html/avinia.ir

# دیتابیس MySQL محلی cPanel (اختیاری در صورت استفاده از پایگاه داده مستقیم cPanel)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=YOUR_CPANEL_USER_agrimanage
MYSQL_USER=YOUR_CPANEL_USER_dbuser
MYSQL_PASSWORD=your_secure_password

# کلید هوش مصنوعی (اختیاری)
GEMINI_API_KEY=
